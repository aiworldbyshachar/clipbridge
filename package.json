{
  "name": "clipbridge",
  "productName": "ClipBridge",
  "version": "1.1.1",
  "description": "Clipboard sync between PC and Mac on your home network, with unlimited history",
  "main": "src/main/main.js",
  "author": "aiworldbyshachar",
  "homepage": "https://aiworldbyshachar.github.io/clipbridge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiworldbyshachar/clipbridge.git"
  },
  "bugs": "https://github.com/aiworldbyshachar/clipbridge/issues",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.clipbridge.app",
    "productName": "ClipBridge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClipBridge-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipBridge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "ClipBridge-macOS.${ext}",
      "extendInfo": {
        "LSAppNapIsDisabled": true,
        "NSLocalNetworkUsageDescription": "ClipBridge syncs your clipboard with your other computers on your home network."
      }
    },
    "dmg": {
      "title": "ClipBridge"
    }
  }
}
